  "components": {
    "schemas": {
      "AgentMode": {
        "type": "string",
        "enum": [
          "SOLO",
          "ASSISTED",
          "WRAP_UP"
        ],
        "title": "AgentMode"
      },
      "AgentModeRequest": {
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/AgentMode"
          }
        },
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "AgentModeRequest"
      },
      "AgentToggleRequest": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "enabled"
        ],
        "title": "AgentToggleRequest"
      },
      "AgentToggleResponse": {
        "properties": {
          "ai_enabled": {
            "type": "boolean",
            "title": "Ai Enabled"
          },
          "metadata_version": {
            "type": "integer",
            "title": "Metadata Version"
          },
          "applied_at": {
            "type": "string",
            "format": "date-time",
            "title": "Applied At"
          }
        },
        "type": "object",
        "required": [
          "ai_enabled",
          "metadata_version",
          "applied_at"
        ],
        "title": "AgentToggleResponse"
      },
      "ConsentRequest": {
        "properties": {
          "accepted": {
            "type": "boolean",
            "title": "Accepted"
          },
          "consent_text_version": {
            "type": "string",
            "title": "Consent Text Version"
          }
        },
        "type": "object",
        "required": [
          "accepted",
          "consent_text_version"
        ],
        "title": "ConsentRequest"
      },
      "ConsentResponse": {
        "properties": {
          "accepted": {
            "type": "boolean",
            "title": "Accepted"
          },
          "session_state": {
            "type": "string",
            "title": "Session State"
          },
          "livekit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LiveKitCredentials"
              },
              {
                "type": "null"
              }
            ]
          },
          "recording_enabled": {
            "type": "boolean",
            "title": "Recording Enabled",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "accepted",
          "session_state"
        ],
        "title": "ConsentResponse"
      },
      "CreateSessionRequest": {
        "properties": {
          "device_id": {
            "type": "string",
            "title": "Device Id"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "locale": {
            "type": "string",
            "title": "Locale",
            "default": "en-US"
          }
        },
        "type": "object",
        "required": [
          "device_id"
        ],
        "title": "CreateSessionRequest"
      },
      "CreateSessionResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "join_code": {
            "type": "string",
            "title": "Join Code"
          },
          "join_code_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Join Code Expires At"
          },
          "deep_link": {
            "type": "string",
            "title": "Deep Link"
          },
          "universal_link": {
            "type": "string",
            "title": "Universal Link"
          },
          "qr_payload": {
            "type": "string",
            "title": "Qr Payload"
          },
          "caller_session_token": {
            "type": "string",
            "title": "Caller Session Token"
          },
          "consent_required": {
            "type": "boolean",
            "title": "Consent Required",
            "default": true
          },
          "consent_text_version": {
            "type": "string",
            "title": "Consent Text Version"
          },
          "consent_text": {
            "type": "string",
            "title": "Consent Text"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "join_code",
          "join_code_expires_at",
          "deep_link",
          "universal_link",
          "qr_payload",
          "caller_session_token",
          "consent_text_version",
          "consent_text"
        ],
        "title": "CreateSessionResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JoinRequest": {
        "properties": {
          "join_code": {
            "type": "string",
            "title": "Join Code"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "join_code"
        ],
        "title": "JoinRequest"
      },
      "JoinResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "livekit": {
            "$ref": "#/components/schemas/LiveKitCredentials"
          },
          "ai_enabled": {
            "type": "boolean",
            "title": "Ai Enabled"
          },
          "agent_mode": {
            "$ref": "#/components/schemas/AgentMode"
          },
          "recording_enabled": {
            "type": "boolean",
            "title": "Recording Enabled"
