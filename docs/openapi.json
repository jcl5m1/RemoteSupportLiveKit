    "/v1/sessions/{session_id}/recordings": {
      "get": {
        "tags": [
          "recordings"
        ],
        "summary": "List Recordings",
        "description": "List the session's media with V4 signed URLs.\n\nThe backend never proxies media bytes -- egress writes straight to GCS and\nclients fetch via short-lived signed URLs (SIGNED_URL_TTL_SECONDS).",
        "operationId": "list_recordings_v1_sessions__session_id__recordings_get",
