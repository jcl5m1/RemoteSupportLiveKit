    "/v1/sessions/{session_id}/agent": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "Set Ai Enabled",
        "description": "Enable/disable the AI agent's speech. **Support auth only** (FR-4.1).",
        "operationId": "set_ai_enabled_v1_sessions__session_id__agent_post",
