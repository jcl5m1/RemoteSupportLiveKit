        ],
        "summary": "Set Agent Mode",
        "description": "Record a mode transition. Called by the agent worker (service auth) or\nforced by support.",
        "operationId": "set_agent_mode_v1_sessions__session_id__agent_mode_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
