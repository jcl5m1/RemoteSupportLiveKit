    "/v1/sessions/{session_id}/utterances": {
      "post": {
        "tags": [
          "transcripts"
        ],
        "summary": "Ingest Utterances",
        "description": "Batched, idempotent utterance ingest. Auth: service (agent worker).\n\nINSERT ... ON CONFLICT (session_id, client_utterance_id) DO NOTHING.\nThat index is what makes the agent's retry-with-backoff loop safe.\n\nOnly finalized utterances arrive here; interims are never persisted (FR-6.3).",
        "operationId": "ingest_utterances_v1_sessions__session_id__utterances_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          },
          {
            "name": "x-service-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Service-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UtteranceIngestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UtteranceIngestResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/transcript": {
      "get": {
        "tags": [
          "transcripts"
        ],
        "summary": "Get Transcript",
        "description": "Ordered utterances with a cursor. The support panel reconciles against\nthis every 10s; the low-latency path is the lk.transcription text stream.",
        "operationId": "get_transcript_v1_sessions__session_id__transcript_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          },
          {
            "name": "since_ms",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Since Ms"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 500,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscriptPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/transcript/export": {
      "post": {
        "tags": [
          "transcripts"
        ],
        "summary": "Export Transcript",
        "description": "Force the JSONL/VTT/TXT/session.json export. Normally triggered by the\nroom_finished webhook; this endpoint exists for retry. Idempotent.",
        "operationId": "export_transcript_v1_sessions__session_id__transcript_export_post",
