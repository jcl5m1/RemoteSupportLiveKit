# --- LiveKit Cloud ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=support-agent

# --- Database ---
DATABASE_URL=postgresql+asyncpg://rs:rs@localhost:5432/remote_support

# --- GCS ---
# LiveKit Egress needs the credential itself, because Egress (not this
# backend) writes the objects.
#
# Base64, NOT raw JSON: the private key contains escaped newlines that .env
# files and shell tooling readily expand into real newlines, which silently
# truncates the value at the first break. Generate with:
#   base64 -i key.json | tr -d '\n'
GCS_BUCKET=remote-support-recordings
GCP_CREDENTIALS_B64=
SIGNED_URL_TTL_SECONDS=900

# --- Auth ---
CALLER_JWT_SECRET=change-me
CALLER_JWT_TTL_SECONDS=3600
SERVICE_API_KEY=change-me-too
# --- Support auth: Google SSO via Firebase Auth ---
# Firebase issues the ID token; the `admin` custom claim gates DELETE .../data.
# JWKS/issuer/audience are derived from the project id, so there is nothing
# else to configure:
#   jwks   https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
#   issuer https://securetoken.google.com/<FIREBASE_PROJECT_ID>
#   aud    <FIREBASE_PROJECT_ID>
FIREBASE_PROJECT_ID=your-firebase-project-id
# At least one of these MUST be non-empty. An empty allowlist would let any
# Google account sign in and claim the trusted support role.
SUPPORT_ALLOWED_DOMAINS=example.com
SUPPORT_ALLOWED_EMAILS=
# Bootstrap admin(s). Once signed in, prefer setting the `admin` custom claim
# via the Firebase Admin SDK and clearing this.
SUPPORT_ADMIN_EMAILS=

# --- Session policy ---
JOIN_CODE_LENGTH=6
JOIN_CODE_TTL_SECONDS=1800
UTTERANCE_RATE_LIMIT=600
UTTERANCE_RATE_LIMIT_WINDOW_SECONDS=60
LIVEKIT_TOKEN_TTL_SECONDS=900
ROOM_EMPTY_TIMEOUT_SECONDS=300
ROOM_MAX_DURATION_SECONDS=7200
IDLE_SESSION_TIMEOUT_SECONDS=900

# --- Consent & retention ---
CONSENT_TEXT_VERSION=v1.0
ALLOW_UNRECORDED_FALLBACK=false
ALLOW_CALLER_DOWNLOAD=false
RETENTION_DAYS=30

# --- Links ---
APP_LINK_HOST=support.example.com
DEEP_LINK_SCHEME=remotesupport

LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Local development -------------------------------------------------
# When true, the backend starts even if LiveKit/GCS credentials are missing.
# /readyz will report those dependencies unhealthy; Postgres can still be ok.
ALLOW_DEGRADED_START=false

# --- Internal test endpoints ------------------------------------------
# When true, exposes /internal/test/* endpoints and /support-web/ used by the
# automated regression harness. These bypass production auth and must NEVER be
# enabled on a public-facing deployment.
ALLOW_TEST_ENDPOINTS=false
