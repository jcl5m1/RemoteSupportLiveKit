LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=support-agent

BACKEND_URL=http://localhost:8000
SERVICE_API_KEY=change-me-too

# --- Models: ALL via LiveKit Cloud Inference ---
# Resolved through the inference gateway using LIVEKIT_API_KEY above.
# No per-provider accounts, no per-provider keys, one bill.
#
# Catalog verified 2026-08: docs.livekit.io/agents/models/inference/
# NOTE: Anthropic/Claude is NOT in the catalog. Do not set an anthropic/*
# identifier here expecting it to resolve.
# Kimi is served via Baseten; the bare identifier lets Inference pick the
# provider. Retired ids that will NOT work: kimi-k2-instruct, kimi-k2.5.
STT_MODEL=deepgram/nova-3:en
LLM_MODEL=moonshotai/kimi-k2.6
TTS_MODEL=cartesia/sonic-3:en
# Same identifier, separate plugin instance. Sharing one across two streams
# is not safe.
SUPPORT_STT_MODEL=deepgram/nova-3:en

AGENT_WAKE_PHRASES=hey assistant,hey agent,hey ai
HEARTBEAT_SECONDS=30
LOG_LEVEL=INFO

# --- Translation bridge (python -m agent.translation_worker start) --------
# Multilingual STT with provider-side language detection. AssemblyAI
# universal streaming multilingual — deepgram nova-3:multi excludes Chinese
# from its multi subset and rejects detect_language on this gateway.
TRANSLATION_STT_MODEL=assemblyai/universal-streaming-multilingual
# Relay mode for fresh rooms: ENGLISH_RELAY (translate everything to English)
# or NATIVE_RELAY (speak to each listener in their own detected/declared
# language). Switchable live over the rs.translation.control data topic.
TRANSLATION_RELAY_MODE=ENGLISH_RELAY
# Per-language TTS voices as lang=provider/model:voice_id; languages missing
# from the map fall back to TTS_MODEL above.
TRANSLATION_TTS_VOICES=es=deepgram/aura-2:athena
# Language spoken to a NATIVE_RELAY listener whose language is not yet known.
TRANSLATION_FALLBACK_LANGUAGE=en

# --- Local development -------------------------------------------------
# When true and LiveKit credentials are missing, the worker keeps the
# container alive without connecting to LiveKit.
ALLOW_DEGRADED_START=false
