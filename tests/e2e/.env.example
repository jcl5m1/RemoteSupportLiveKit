# E2E test configuration.
# Copy to tests/e2e/.env and fill in real values.

# Backend to test against. For local runs:
#   BACKEND_URL=http://localhost:8000
# For production regression runs:
#   BACKEND_URL=https://remotesupport.lgitech.net
BACKEND_URL=https://remotesupport.lgitech.net

# SERVICE_API_KEY from backend/.env (must match the backend under test).
SERVICE_API_KEY=change-me

# LiveKit websocket URL. Only needed if the backend returns a relative/empty ws_url.
LIVEKIT_URL=wss://your-project.livekit.cloud
