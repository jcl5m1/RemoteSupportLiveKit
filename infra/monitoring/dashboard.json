      "targets": [
        {"expr": "sum(rate(remote_support_request_duration_seconds_count[5m]))", "refId": "A"}
      ],
      "title": "Request Rate",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.05}]},
