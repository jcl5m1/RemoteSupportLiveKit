        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "id": 5,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [
        {"expr": "remote_support_readyz_dependency_healthy", "legendFormat": "{{name}}", "refId": "A"}
      ],
      "title": "Dependency Health",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {"custom": {"drawStyle": "line", "lineInterpolation": "linear", "spanNulls": false}, "unit": "reqps"}
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "id": 6,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "sum by (path) (rate(remote_support_request_duration_seconds_count[5m]))", "legendFormat": "{{path}}", "refId": "A"}
      ],
      "title": "Request Rate by Path",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {"custom": {"drawStyle": "line"}, "unit": "s"}
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "id": 7,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, path) (rate(remote_support_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{path}}", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by (le, path) (rate(remote_support_request_duration_seconds_bucket[5m])))", "legendFormat": "p99 {{path}}", "refId": "B"}
